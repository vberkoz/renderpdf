{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "analytics/**/*.js",
    "webhooks/**/*.js",
    "auth/account-linker/**/*.js",
    "scripts/**/*.js"
  ],
  "exclude": ["node_modules", "dashboard/**/*"]
}
