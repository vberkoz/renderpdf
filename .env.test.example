# .env.test.example - RenderPDF Local Testing & Mocking Environment
#
# Use these variables to configure offline/local unit tests or local emulation
# (e.g. LocalStack, DynamoDB Local) without requiring deployed AWS credentials.

# --- AWS Credentials & Region ---
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-access-key
AWS_SECRET_ACCESS_KEY=mock-secret-key

# --- DynamoDB Table Names ---
TABLE_NAME=renderpdf-test-usage
API_KEYS_TABLE=renderpdf-test-keys
TEMPLATE_TABLE_NAME=renderpdf-test-templates
DOCUMENT_STORE_TABLE_NAME=renderpdf-test-document-store

# --- S3 Buckets ---
BUCKET_NAME=renderpdf-test-pdfs
PACKAGE_BUCKET_NAME=renderpdf-test-packages

# --- SQS Queues ---
WEBHOOK_QUEUE_URL=http://localhost:4566/000000000000/renderpdf-webhook-queue
BATCH_QUEUE_URL=http://localhost:4566/000000000000/renderpdf-batch-queue

# --- Cognito & Auth ---
USER_POOL_ID=us-east-1_MockPool123
STATS_ALLOWED_EMAIL=vberkoz@gmail.com
OPERATIONS_ALERT_EMAIL=ops@example.com
NOTIFICATION_FROM_EMAIL=RenderPDF <support@renderpdf.vberkoz.com>
SES_REGION=us-east-1

# --- API Gateway Usage Plan IDs ---
FREE_USAGE_PLAN_ID=mock-free-plan-id
STARTER_USAGE_PLAN_ID=mock-starter-plan-id
PRO_USAGE_PLAN_ID=mock-pro-plan-id

# --- Paddle Billing (Sandbox/Mock) ---
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_BASE=https://sandbox-api.paddle.com
PADDLE_API_KEY=mock-paddle-api-key
PADDLE_CLIENT_TOKEN=mock-paddle-client-token
PADDLE_WEBHOOK_SECRET=mock-paddle-webhook-secret
PADDLE_CHECKOUT_URL=https://renderpdf.vberkoz.com/app/
PADDLE_STARTER_PRICE_ID=pri_starter_mock_01
PADDLE_STARTER_ANNUAL_PRICE_ID=pri_starter_annual_mock_01
PADDLE_PRO_PRICE_ID=pri_pro_mock_01
PADDLE_PRO_ANNUAL_PRICE_ID=pri_pro_annual_mock_01
PADDLE_OVERAGE_PRICE_ID=pri_01m2fzxsmngvj4a5186zydh2ej

# --- Plan Quotas ---
FREE_MONTHLY_QUOTA=25
STARTER_MONTHLY_QUOTA=5000
PRO_MONTHLY_QUOTA=20000
OVERAGE_RENDER_CREDITS=1000

# --- Telegram Alerts (Optional) ---
TELEGRAM_BOT_TOKEN=123456789:mock-telegram-token
TELEGRAM_CHAT_ID=123456789

# --- Trial Mode ---
TRIAL_MODE_ONLY=false
